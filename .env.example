# Tests mock Supabase; leave both empty for an offline build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set the approved HTTPS origin at build time before switching domains.
NEXT_PUBLIC_SITE_ORIGIN=
# Private server-only 32-byte lowercase hex key; never NEXT_PUBLIC_.
# DB Vault name must be PUBLICATION_BOUNDARY_HMAC_KEY:<key-id>.
# Provisioning real keys is a separate controlled rollout gate.
PUBLICATION_BOUNDARY_HMAC_KEY=
PUBLICATION_BOUNDARY_HMAC_KEY_ID=
