{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inmuebles-directos",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Redimensiona las fotos de anuncios a WebP (rendimiento P1c); facturado por transformación única al mes.
  "images": { "binding": "IMAGES" },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "inmuebles-directos" }
  ],
  // Public (non-secret) runtime values. NEXT_PUBLIC_* are also inlined at build time.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://vosijgnyyyjvqpzbhtuh.supabase.co",
    "NEXT_PUBLIC_SITE_ORIGIN": "https://inmueblesdirectosperu.com"
  },
  // Dominio propio (comprado en Cloudflare). www y *.workers.dev redirigen al dominio canónico (proxy.ts).
  // workers.dev sigue activo solo para redirigir los enlaces antiguos al dominio propio.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "inmueblesdirectosperu.com", "custom_domain": true },
    { "pattern": "www.inmueblesdirectosperu.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
